# Fluxora — Backend STAGING (Render)
# Copiar para Render Environment Variables. Nunca commitar valores reais.

APP_ENV=staging
NODE_ENV=production
PORT=10000

# Supabase STAGING
SUPABASE_URL=YOUR_SUPABASE_STAGING_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_STAGING_SERVICE_ROLE_KEY

# Security
ADMIN_MFA_REQUIRED=true
CORS_ALLOWED_ORIGINS=https://waterpro-chi.vercel.app

# WhatsApp (Meta OFF in 6A)
WHATSAPP_PROVIDER=mock

# Meta — PENDING CONFIGURATION (Fase 6B)
META_GRAPH_API_VERSION=v25.0
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_EMBEDDED_SIGNUP_CONFIGURATION_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_WEBHOOK_CALLBACK_URL=https://YOUR-RENDER-STAGING-API.onrender.com/api/v1/webhooks/whatsapp

# Optional
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LOG_LEVEL=info

# E2E ONLY — NÃO usar no Render staging publicado
# E2E_SKIP_MFA=1
